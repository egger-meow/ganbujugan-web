---
import { assets } from '../config/assets';
import { siteConfig } from '../config/site';
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-brand-col">
      <div class="footer-brand">
        <img
          src={assets.appIcon.src}
          alt={assets.appIcon.alt}
          width="48"
          height="48"
          class="footer-icon"
        />
        <div>
          <span class="footer-title">{siteConfig.siteName}</span>
          <p class="footer-tagline">{siteConfig.tagline}</p>
        </div>
      </div>
      <p class="footer-desc">
        {siteConfig.mission}
      </p>
      <div class="footer-campus-badges">
        <span class="badge badge-emerald">陽明交大 NYCU</span>
        <span class="badge badge-sky">清華大學 NTHU</span>
      </div>
    </div>

    <div class="footer-nav-col">
      <span class="footer-col-title">平台導覽</span>
      <ul class="footer-links">
        <li><a href="/#how-it-works">怎麼玩</a></li>
        <li><a href="/#activities">支援活動類型</a></li>
        <li><a href="/#safety">安全與信任機制</a></li>
        <li><a href="/#faq">常見問答</a></li>
        <li><a href="/download">取得 App</a></li>
      </ul>
    </div>

    <div class="footer-nav-col">
      <span class="footer-col-title">條款與隱私</span>
      <ul class="footer-links">
        <li><a href="/terms">服務條款</a></li>
        <li><a href="/privacy">隱私權政策</a></li>
        <li><a href="/account-deletion">帳號刪除說明</a></li>
        <li><a href="/support">支援與回報中心</a></li>
      </ul>
    </div>

    <div class="footer-notice-col">
      <span class="footer-col-title">校園身份驗證說明</span>
      <p class="footer-eligibility-note">
        本服務目前僅開放持有 <strong>@nycu.edu.tw</strong> 或 <strong>@nthu.edu.tw</strong> 學校信箱之在校成員註冊使用，信箱僅供校籍判定與驗證碼寄送，不具非學校官方背書之意涵。
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright">
        &copy; {new Date().getFullYear()} 搞一個 (Dare2Jo). 找到現在也想一起的人。
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface-card);
    border-top: 1px solid var(--color-outline-variant);
    margin-top: auto;
    padding-top: var(--space-3xl);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .footer-content {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .footer-content {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: var(--space-xl);
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .footer-icon {
    border-radius: var(--radius-sm);
  }

  .footer-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .footer-tagline {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .footer-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    max-width: 320px;
  }

  .footer-campus-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .footer-col-title {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text-main);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links a {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-eligibility-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-outline-variant);
    padding: var(--space-lg) 0;
    background-color: var(--color-surface);
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    font-size: 0.82rem;
    color: var(--color-text-subtle);
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
    }
  }

</style>
