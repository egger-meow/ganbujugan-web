{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dare2jo-web",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "dare2jo.jjmowlab.com",
      "custom_domain": true
    }
  ]
}
